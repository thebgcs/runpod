meta {
  name: Check endpoint health
  type: http
  seq: 0
}

get {
  url: {{base_url}}/{{endpoint_id}}/health
  body: none
  auth: bearer
}

auth:bearer {
  token: {{runpod_api_key}}
}

tests {
  test("The endpoint returns worker and job counts", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("workers");
    expect(res.getBody()).to.have.property("jobs");
  });
}
